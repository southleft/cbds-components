{
  "name": "cbds-components",
  "description": "CBDS design system components.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens/tokens.css",
    "./tokens/dark.css": "./dist/tokens/tokens.dark.css",
    "./tokens/brutalist.css": "./dist/tokens/tokens.brutalist.css",
    "./theme.css": "./dist/tokens/theme.css",
    "./reset.css": "./dist/tokens/reset.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "tokens": "node tokens/build.mjs",
    "tokens:watch": "concurrently \"chokidar 'tokens/json/**/*.json' -c 'npm run tokens'\"",
    "dev": "concurrently \"npm run tokens\" \"vite\"",
    "build": "npm run tokens && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build",
    "story-ui": "story-ui start --port 4001",
    "storybook-with-ui": "concurrently \"npm run storybook\" \"npm run story-ui\"",
    "build:package": "npm run tokens && vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/copy-styles.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.1",
    "@eslint/js": "^9.35.0",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tpitre/story-ui": "^5.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/browser": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^10.3.5",
    "globals": "^16.3.0",
    "playwright": "^1.55.0",
    "react-live": "^4.1.8",
    "storybook": "^10.3.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vitest": "^5.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
