# Story UI Configuration
# Copy this file to .env and add your Claude API key
#   cp .env.example .env

# Claude API Key (required for Story UI)
# Get your key from: https://console.anthropic.com/
CLAUDE_API_KEY=your-api-key-here

# Claude Model (optional, defaults to claude-sonnet-4-20250514)
CLAUDE_MODEL=claude-sonnet-4-20250514

# Story UI MCP server port
VITE_STORY_UI_PORT=4001
